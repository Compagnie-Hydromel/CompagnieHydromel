# Copy to docs/docker/.env. Never commit real tokens or passwords.
BARMAN_TOKEN=
MENESTREL_TOKEN=
ARCHIVEUSE_TOKEN=
WEBSERVER_BOT=BARMAN

APP_URL=http://localhost:8000
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=replace-with-a-long-random-secret
WEB_BIND_ADDRESS=127.0.0.1
WEB_PUBLISHED_PORT=8000

# Existing Lavalink v4 instance, reachable FROM the container.
# localhost would refer to the container itself, not your host.
LAVALINK_URI=http://your-lavalink-host:2333
LAVALINK_PASSWORD=replace-with-your-lavalink-password

# Optional: published image. Adjust owner/repository to your fork if necessary.
HYDROMEL_IMAGE=ghcr.io/compagnie-hydromel/compagniehydromel:latest

# Only used with compose.mariadb.yml. SQLite is the default.
DB_NAME=compagnieHydromel
DB_USER=hydromel
DB_PASSWORD=replace-with-a-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-root-password
